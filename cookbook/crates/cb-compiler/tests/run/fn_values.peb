fn inc(x: int) -> int { x + 1 }
fn dbl(x: int) -> int { x * 2 }
fn apply_all(fs: [fn(int) -> int], x: int) -> int {
    let mut v = x;
    let mut i = 0;
    while i < len(fs) { v = fs[i](v); i += 1; }
    v
}
fn compose(f: fn(int) -> int, g: fn(int) -> int, x: int) -> int { g(f(x)) }
fn main() {
    println(to_str(apply_all([inc, dbl, inc], 5)));
    println(to_str(compose(dbl, inc, 5)));
    let f = dbl;
    println(to_str(f(21)));
}
