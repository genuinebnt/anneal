enum Shape { Circle(int), Rect { w: int, h: int }, Empty }
fn area(s: Shape) -> int {
    match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect { w, h } => w * h,
        Shape::Empty => 0,
    }
}
fn main() {
    println(to_str(area(Shape::Circle(2))));
    println(to_str(area(Shape::Rect { w: 3, h: 5 })));
    println(to_str(area(Shape::Empty)));
}
