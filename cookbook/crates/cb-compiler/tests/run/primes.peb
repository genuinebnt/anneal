fn is_prime(n: int) -> bool {
    if n < 2 { return false; }
    let mut d = 2;
    while d * d <= n {
        if n % d == 0 { return false; }
        d += 1;
    }
    true
}
fn main() {
    let mut n = 0;
    let mut count = 0;
    while count < 10 {
        if is_prime(n) { print(to_str(n) + " "); count += 1; }
        n += 1;
    }
    println("");
}
