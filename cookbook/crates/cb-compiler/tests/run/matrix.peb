fn main() {
    let mut m = [];
    let mut i = 0;
    while i < 3 {
        let mut row = [];
        let mut j = 0;
        while j < 3 { push(row, i * 3 + j); j += 1; }
        push(m, row);
        i += 1;
    }
    m[1][1] = 100;
    let mut total = 0;
    i = 0;
    while i < 3 {
        let mut j = 0;
        while j < 3 { total += m[i][j]; j += 1; }
        i += 1;
    }
    println(to_str(total));
}
