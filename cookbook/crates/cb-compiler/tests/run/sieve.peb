fn sieve(n: int) -> [int] {
    let mut is_prime = [];
    let mut i = 0;
    while i <= n { push(is_prime, true); i += 1; }
    is_prime[0] = false;
    is_prime[1] = false;
    let mut p = 2;
    while p * p <= n {
        if is_prime[p] {
            let mut m = p * p;
            while m <= n { is_prime[m] = false; m += p; }
        }
        p += 1;
    }
    let mut out = [];
    let mut k = 0;
    while k <= n {
        if is_prime[k] { push(out, k); }
        k += 1;
    }
    out
}
fn main() {
    let ps = sieve(50);
    let mut i = 0;
    while i < len(ps) { print(to_str(ps[i]) + ","); i += 1; }
    println("");
    println("count=" + to_str(len(ps)));
}
