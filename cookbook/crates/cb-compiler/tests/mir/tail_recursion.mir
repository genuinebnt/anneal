=== after: tco, simplify-cfg ===
// monomorphisation: 2 function instances
// fn#0 (main)
fn main() -> () {
    let _0: int;
    let _1: str;
    let _2: ();
  bb0:
    _0 = call fn#1(1000, 0) -> bb1
  bb1:
    _1 = to_str(_0)
    _2 = println(_1)
    return ()
}
// fn#1
fn sum_to(_0: int, _1: int) -> int {
    let _2: bool;
    let _3: int;
    let _4: int;
    let _5: int;
    let _6: int;
  bb0:
    goto bb3
  bb1:
    _3 = _1
    return _3
  bb2:
    _4 = _0 - 1
    _5 = _1 + _0
    _0 = _4
    _1 = _5
    goto bb3
  bb3:
    _2 = _0 == 0
    branch _2 -> bb1, bb2
}
