fn sort(mut xs: [int]) -> [int] {
    let n = len(xs);
    let mut i = 0;
    while i < n {
        let mut j = 0;
        while j + 1 < n - i {
            if xs[j] > xs[j + 1] {
                let t = xs[j];
                xs[j] = xs[j + 1];
                xs[j + 1] = t;
            }
            j += 1;
        }
        i += 1;
    }
    xs
}
fn main() {
    let s = sort([5, 2, 9, 1, 5, 6]);
    let mut i = 0;
    while i < len(s) { print(to_str(s[i]) + " "); i += 1; }
    println("");
}
