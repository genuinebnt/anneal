fn bsearch(xs: [int], t: int) -> int {
    let mut lo = 0;
    let mut hi = len(xs) - 1;
    while lo <= hi {
        let mid = (lo + hi) / 2;
        if xs[mid] == t { return mid; }
        if xs[mid] < t { lo = mid + 1; } else { hi = mid - 1; }
    }
    -1
}
fn main() {
    let xs = [1, 3, 5, 7, 9, 11];
    println(to_str(bsearch(xs, 7)) + " " + to_str(bsearch(xs, 4)));
}
