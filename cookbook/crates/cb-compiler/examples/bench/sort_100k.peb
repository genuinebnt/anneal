// Quicksort over 100k pseudo-random integers (recursion plus array swaps).
fn partition(mut a: [int], lo: int, hi: int) -> int {
    let pivot = a[(lo + hi) / 2];
    let mut i = lo - 1;
    let mut j = hi + 1;
    loop {
        i += 1;
        while a[i] < pivot { i += 1; }
        j -= 1;
        while a[j] > pivot { j -= 1; }
        if i >= j { return j; }
        let t = a[i];
        a[i] = a[j];
        a[j] = t;
    }
}

fn quicksort(a: [int], lo: int, hi: int) {
    if lo < hi {
        let p = partition(a, lo, hi);
        quicksort(a, lo, p);
        quicksort(a, p + 1, hi);
    }
}

fn main() {
    let mut a = [];
    let mut x = 12345;
    let mut i = 0;
    while i < 100000 {
        x = (x * 1103515245 + 12345) % 2147483648;
        push(a, x % 1000000);
        i += 1;
    }
    quicksort(a, 0, len(a) - 1);
    let mut ok = true;
    let mut k = 1;
    while k < len(a) {
        if a[k - 1] > a[k] { ok = false; }
        k += 1;
    }
    println(to_str(ok));
    println(to_str(a[0]) + " " + to_str(a[50000]) + " " + to_str(a[99999]));
}
