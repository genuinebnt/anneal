// Showcase: generics, enums, match, higher-order functions, loops.
enum Option<T> { None, Some(T) }

struct Point { x: int, y: int }

enum Shape { Circle(int), Rect { w: int, h: int }, Empty }

fn map<T, U>(xs: [T], f: fn(T) -> U) -> [U] {
    let mut out = [];
    let mut i = 0;
    while i < len(xs) {
        push(out, f(xs[i]));
        i += 1;
    }
    out
}

fn square(x: int) -> int { x * x }

fn find_first_even(xs: [int]) -> Option<int> {
    let mut i = 0;
    while i < len(xs) {
        if xs[i] % 2 == 0 { return Option::Some(xs[i]); }
        i += 1;
    }
    Option::None
}

fn area(s: Shape) -> int {
    match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect { w, h } => w * h,
        Shape::Empty => 0,
    }
}

fn fib(n: int) -> int { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }

fn main() {
    let sq = map([1, 2, 3, 4], square);
    println(to_str(sq[3]));
    match find_first_even([1, 3, 6]) {
        Option::Some(v) => println("even: " + to_str(v)),
        Option::None => println("none"),
    }
    let p = Point { x: 1, y: 2 };
    println(to_str(p.x + p.y));
    println(to_str(area(Shape::Rect { w: 3, h: 4 }) + area(Shape::Circle(2))));
    let r = loop { break fib(15); };
    println(to_str(r));
}
