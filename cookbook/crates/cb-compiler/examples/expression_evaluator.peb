enum Expr { Num(int), Add(Expr, Expr), Mul(Expr, Expr), Neg(Expr) }
fn eval(e: Expr) -> int {
    match e {
        Expr::Num(n) => n,
        Expr::Add(a, b) => eval(a) + eval(b),
        Expr::Mul(a, b) => eval(a) * eval(b),
        Expr::Neg(a) => -eval(a),
    }
}
fn main() {
    let e = Expr::Add(Expr::Num(2), Expr::Mul(Expr::Num(3), Expr::Neg(Expr::Num(4))));
    println(to_str(eval(e)));
}
